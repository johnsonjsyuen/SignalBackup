<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: root covers files, databases and prefs; nothing (account, settings, upload state) leaves the device via backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
